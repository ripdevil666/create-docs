// ============================================================================
// 2. BỘ TÔ SÁNG CÚ PHÁP LUAU (LUAU SYNTAX HIGHLIGHTER)
// ============================================================================
const LuauCodeBlock = ({ code, filename = 'ServerScriptService/TeleportHandler.server.luau' }) => {
  const [copied, setCopied] = useState(false);

  const handleCopy = () => {
    navigator.clipboard.writeText(code);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  // Highlight cú pháp cơ bản cho Luau
  const highlightLuau = (line) => {
    if (line.trim().startsWith('--')) {
      return <span className="text-[#6B7280] italic">{line}</span>;
    }

    const tokens = line.split(/(\b(?:local|function|end|if|then|else|elseif|return|for|in|do|while|true|false|nil|and|or|not|type|export)\b|"[^"]*"|'[^']*'|\b\d+\b)/g);

    return tokens.map((token, idx) => {
      if (/^(local|function|end|if|then|else|elseif|return|for|in|do|while|type|export)$/.test(token)) {
        return <span key={idx} className="text-[#FF7B72] font-medium">{token}</span>;
      }
      if (/^(true|false|nil|and|or|not)$/.test(token)) {
        return <span key={idx} className="text-[#79C0FF] font-medium">{token}</span>;
      }
      if (/^(".*"|'.*')$/.test(token)) {
        return <span key={idx} className="text-[#A5D6FF]">{token}</span>;
      }
      if (/^\d+$/.test(token)) {
        return <span key={idx} className="text-[#79C0FF]">{token}</span>;
      }
      return <span key={idx} className="text-[#E6EDF3]">{token}</span>;
    });
  };

  return (
    <div className="my-5 rounded-lg border border-[#2E3138] bg-[#16181D] overflow-hidden shadow-sm">
      <div className="flex items-center justify-between px-4 py-2 bg-[#1D2026] border-b border-[#2E3138]">
        <div className="flex items-center gap-2 text-xs text-[#9CA3AF] font-mono">
          <Terminal className="w-3.5 h-3.5 text-[#335FFF]" />
          <span>{filename}</span>
        </div>
        <button
          onClick={handleCopy}
          className="flex items-center gap-1.5 px-2.5 py-1 rounded text-xs font-medium text-[#D5D7DD] hover:text-[#F7F7F8] hover:bg-[#2B2D31] transition-colors"
          title="Copy code"
        >
          {copied ? (
            <>
              <Check className="w-3.5 h-3.5 text-emerald-400" />
              <span className="text-emerald-400">Copied</span>
            </>
          ) : (
            <>
              <Copy className="w-3.5 h-3.5" />
              <span>Copy</span>
            </>
          )}
        </button>
      </div>
      <div className="p-4 overflow-x-auto font-mono text-[13px] leading-6">
        {code.split('\n').map((line, index) => (
          <div key={index} className="table-row">
            <span className="table-cell pr-4 text-right select-none text-[#4B5563] text-xs w-8">
              {index + 1}
            </span>
            <span className="table-cell whitespace-pre">{highlightLuau(line)}</span>
          </div>
        ))}
      </div>
    </div>
  );
};

