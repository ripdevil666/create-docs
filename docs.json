// Fallback nội dung tự động cho các mục menu khác để không bao giờ bị trang trống
const getArticleById = (id) => {
  if (ARTICLES_DB[id]) return ARTICLES_DB[id];

  // Tìm tên từ navigation config
  let foundTitle = id.replace(/-/g, ' ').replace(/\b\w/g, (l) => l.toUpperCase());
  let foundPath = `content/learn/${id}.mdx`;

  NAVIGATION_CONFIG.sidebar.topItems.forEach((item) => {
    if (item.id === id) {
      foundTitle = item.title;
      foundPath = item.path;
    }
  });
  NAVIGATION_CONFIG.sidebar.sections.forEach((sec) => {
    sec.items.forEach((item) => {
      if (item.id === id) {
        foundTitle = item.title;
        foundPath = item.path;
      }
      if (item.children) {
        item.children.forEach((child) => {
          if (child.id === id) {
            foundTitle = child.title;
            foundPath = child.path;
          }
        });
      }
    });
  });

  return {
    id,
    breadcrumbs: ['Learn', 'Experiences', foundTitle],
    githubPath: foundPath,
    titleEn: foundTitle,
    titleVi: foundTitle,
    headings: [
      { id: 'overview-section', textEn: 'Overview', textVi: 'Tổng quan', level: 2 },
      { id: 'implementation', textEn: 'Implementation Guide', textVi: 'Hướng dẫn triển khai', level: 2 },
    ],
    renderContent: (lang) => (
      <div className="space-y-6 text-[#D5D7DD] leading-7 text-[15px]">
        <p>
          {lang === 'en'
            ? `This documentation page covers core workflows and API best practices for ${foundTitle} in Roblox Studio.`
            : `Trang tài liệu này hướng dẫn quy trình chuẩn và các phương pháp tối ưu cho ${foundTitle} trong Roblox Studio.`}
        </p>
        <section id="overview-section" className="pt-4 scroll-mt-20">
          <h2 className="text-2xl font-bold text-[#F7F7F8] mb-3">
            {lang === 'en' ? 'Overview' : 'Tổng quan'}
          </h2>
          <p>
            {lang === 'en'
              ? `Edit the Markdown file at ${foundPath} in your GitHub repository to customize this article.`
              : `Chỉnh sửa tệp Markdown tại đường dẫn ${foundPath} trong kho lưu trữ GitHub của bạn để cập nhật nội dung trang này.`}
          </p>
        </section>
        <section id="implementation" className="pt-4 scroll-mt-20">
          <h2 className="text-2xl font-bold text-[#F7F7F8] mb-3">
            {lang === 'en' ? 'Implementation Guide' : 'Hướng dẫn triển khai'}
          </h2>
          <LuauCodeBlock
            filename={`ServerScriptService/${id.replace(/[^a-zA-Z0-9]/g, '')}.server.luau`}
            code={`-- Example Luau implementation for ${foundTitle}
local ReplicatedStorage = game:GetService("ReplicatedStorage")

print("Initialized ${foundTitle} module successfully!")`}
          />
        </section>
      </div>
    ),
  };
};

