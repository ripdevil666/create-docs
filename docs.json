// 7. COMPONENT CHÍNH (APP) - BỐ CỤC 4 CỘT CHUẨN ROBLOX CREATOR DOCS
// ============================================================================
export default function App() {
  const [activeArticleId, setActiveArticleId] = useState('projects-overview');
  const [leftRailCollapsed, setLeftRailCollapsed] = useState(false);
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);
  const [expandedGroups, setExpandedGroups] = useState({ projects: true, scripting: false });
  const [lang, setLang] = useState('en'); // 'en' | 'vi'
  const [searchOpen, setSearchOpen] = useState(false);
  const [githubModalOpen, setGithubModalOpen] = useState(false);
  const [activeHeadingId, setActiveHeadingId] = useState('');
  const [feedbackGiven, setFeedbackGiven] = useState(null);

  const mainScrollRef = useRef(null);
  const activeArticle = useMemo(() => getArticleById(activeArticleId), [activeArticleId]);

  // Phím tắt Ctrl+K / Cmd+K mở tìm kiếm
  useEffect(() => {
    const handleKeyDown = (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        setSearchOpen((prev) => !prev);
      } else if (e.key === 'Escape') {
        setSearchOpen(false);
        setGithubModalOpen(false);
      }
    };
    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, []);

  // Reset scroll và feedback khi đổi bài viết
  useEffect(() => {
    setFeedbackGiven(null);
    if (activeArticle.headings?.length > 0) {
      setActiveHeadingId(activeArticle.headings[0].id);
    }
    if (mainScrollRef.current) {
      mainScrollRef.current.scrollTo({ top: 0, behavior: 'smooth' });
    }
  }, [activeArticleId, activeArticle]);

  // Real-time Scroll-Spy cho mục lục bên phải ("On this page")
  useEffect(() => {
    const container = mainScrollRef.current;
    if (!container) return;

    const handleScroll = () => {
      const headings = activeArticle.headings || [];
      let currentId = headings[0]?.id || '';

      for (const h of headings) {
        const el = document.getElementById(h.id);
        if (el) {
          const rect = el.getBoundingClientRect();
          if (rect.top <= 140) {
            currentId = h.id;
          }
        }
      }
      if (currentId) setActiveHeadingId(currentId);
    };

    container.addEventListener('scroll', handleScroll, { passive: true });
    return () => container.removeEventListener('scroll', handleScroll);
  }, [activeArticle]);

  const toggleGroup = (groupId) => {
    setExpandedGroups((prev) => ({ ...prev, [groupId]: !prev[groupId] }));
  };

  const scrollToHeading = (id) => {
    const el = document.getElementById(id);
    if (el && mainScrollRef.current) {
      el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      setActiveHeadingId(id);
    }
  };

  return (
    <div className="h-screen w-full bg-[#111215] text-[#F7F7F8] flex overflow-hidden font-sans antialiased selection:bg-[#335FFF] selection:text-white">
      {/* =====================================================================
          CỘT 1: LEFT GLOBAL RAIL (~200px, thu gọn được, KHÔNG CÓ SIGN IN)
         ===================================================================== */}
      <aside
        className={`hidden md:flex flex-col justify-between bg-[#14161A] border-r border-[#2E3138] transition-all duration-200 shrink-0 ${
          leftRailCollapsed ? 'w-16' : 'w-[200px]'
        }`}
      >
        <div>
          {/* Logo Thương hiệu kiểu Roblox Creator */}
          <div className="h-14 px-4 flex items-center gap-2.5 border-b border-[#2E3138]/60">
            <div className="w-6 h-6 flex items-center justify-center shrink-0">
              {/* Biểu tượng hình vuông nghiêng đặc trưng */}
              <div className="w-5 h-5 border-[3.5px] border-[#F7F7F8] rotate-12 rounded-[2px] flex items-center justify-center">
                <div className="w-1.5 h-1.5 bg-[#14161A]" />
              </div>
            </div>
            {!leftRailCollapsed && (
              <span className="font-extrabold tracking-wider text-sm text-[#F7F7F8] truncate">
                CREATOR
              </span>
            )}
          </div>

          {/* Menu điều hướng chính (Learn active mặc định) */}
          <nav className="p-2.5 space-y-1">
            {NAVIGATION_CONFIG.rail.map((item) => {
              const Icon = item.icon;
              return (
                <button
                  key={item.id}
                  onClick={() => {
                    if (item.id === 'learn') setActiveArticleId('projects-overview');
                  }}
                  title={item.label}
                  className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-colors ${
                    item.active
                      ? 'bg-[#272930] text-[#F7F7F8] font-semibold'
                      : 'text-[#D5D7DD] hover:bg-[#1E2025] hover:text-[#F7F7F8]'
                  }`}
                >
                  <Icon className={`w-4 h-4 shrink-0 ${item.active ? 'text-[#F7F7F8]' : 'text-[#9CA3AF]'}`} />
                  {!leftRailCollapsed && <span className="truncate">{item.label}</span>}
                </button>
              );
            })}
          </nav>
        </div>

        {/* Phần đáy cột 1: Liên kết ngoài + Nút Hide sidebar (Tuyệt đối không có Sign in) */}
        <div className="p-2.5 border-t border-[#2E3138]/80 space-y-1">
          {NAVIGATION_CONFIG.externalLinks.map((ext) => (
            <a
              key={ext.label}
              href={ext.href}
              target="_blank"
              rel="noreferrer"
              title={ext.label}
              className="w-full flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-[#D5D7DD] hover:bg-[#1E2025] hover:text-[#F7F7F8] transition-colors"
            >
              <ExternalLink className="w-4 h-4 text-[#9CA3AF] shrink-0" />
              {!leftRailCollapsed && <span className="truncate">{ext.label}</span>}
            </a>
          ))}

          <button
            onClick={() => setLeftRailCollapsed(!leftRailCollapsed)}
            className="w-full flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-[#D5D7DD] hover:bg-[#1E2025] hover:text-[#F7F7F8] transition-colors"
            title={leftRailCollapsed ? 'Expand sidebar' : 'Hide sidebar'}
          >
            {leftRailCollapsed ? (
              <PanelLeftOpen className="w-4 h-4 text-[#9CA3AF] shrink-0" />
            ) : (
              <>
                <PanelLeftClose className="w-4 h-4 text-[#9CA3AF] shrink-0" />
                <span className="truncate">Hide sidebar</span>
              </>
            )}
          </button>
        </div>
      </aside>

      {/* =====================================================================
          CỘT 2: DOCS NAVIGATION SIDEBAR (~260px)
         ===================================================================== */}
      <aside
        className={`${
          mobileMenuOpen ? 'fixed inset-y-0 left-0 z-40 flex' : 'hidden lg:flex'
        } w-[260px] flex-col bg-[#16181D] border-r border-[#2E3138] shrink-0`}
      >
        {/* Tiêu đề quay lại chuyên mục cha (< Experiences) */}
        <div className="h-14 px-4 flex items-center justify-between border-b border-[#2E3138]">
          <button
            onClick={() => setActiveArticleId('overview')}
            className="flex items-center gap-2 text-sm font-semibold text-[#F7F7F8] hover:text-[#335FFF] transition-colors"
          >
            <ChevronLeft className="w-4 h-4 text-[#9CA3AF]" />
            <span>{NAVIGATION_CONFIG.sidebar.backLabel}</span>
          </button>
          {mobileMenuOpen && (
            <button onClick={() => setMobileMenuOpen(false)} className="lg:hidden p-1 text-[#9CA3AF]">
              <X className="w-5 h-5" />
            </button>
          )}
        </div>

        {/* Cây thư mục tài liệu */}
        <div className="flex-1 overflow-y-auto px-3 py-4 space-y-5 text-[13.5px]">
          {/* Nhóm Overview trên cùng */}
          <div>
            <div className="px-2.5 mb-1.5 text-xs font-semibold text-[#9CA3AF]">Overview</div>
            <div className="space-y-0.5">
              {NAVIGATION_CONFIG.sidebar.topItems.map((item) => {
                const isActive = activeArticleId === item.id;
                return (
                  <button
                    key={item.id}
                    onClick={() => {
                      setActiveArticleId(item.id);
                      setMobileMenuOpen(false);
                    }}
                    className={`w-full flex items-center justify-between px-2.5 py-1.5 rounded-md text-left transition-colors ${
                      isActive
                        ? 'bg-[#272930] text-[#F7F7F8] font-medium'
                        : 'text-[#D5D7DD] hover:bg-[#1F2229] hover:text-[#F7F7F8]'
                    }`}
                  >
                    <span className="truncate">{lang === 'en' ? item.title : item.titleVi}</span>
                    {item.id === 'ai-workflows' && <ChevronRight className="w-3.5 h-3.5 text-[#9CA3AF]" />}
                  </button>
                );
              })}
            </div>
          </div>

          {/* Các nhóm phân cấp Create & Scale */}
          {NAVIGATION_CONFIG.sidebar.sections.map((section) => (
            <div key={section.category}>
              <div className="px-2.5 mb-1.5 text-xs font-semibold text-[#9CA3AF]">
                {section.category}
              </div>
              <div className="space-y-0.5">
                {section.items.map((item) => {
                  const hasChildren = item.children && item.children.length > 0;
                  const isExpanded = !!expandedGroups[item.id];
                  const isItemActive = activeArticleId === item.id;

                  return (
                    <div key={item.id}>
                      <button
                        onClick={() => {
                          if (hasChildren) {
                            toggleGroup(item.id);
                          } else {
                            setActiveArticleId(item.id);
                            setMobileMenuOpen(false);
                          }
                        }}
                        className={`w-full flex items-center justify-between px-2.5 py-1.5 rounded-md text-left transition-colors ${
                          isItemActive
                            ? 'bg-[#272930] text-[#F7F7F8] font-medium'
                            : 'text-[#D5D7DD] hover:bg-[#1F2229] hover:text-[#F7F7F8]'
                        }`}
                      >
                        <span className="truncate">{lang === 'en' ? item.title : item.titleVi}</span>
                        {hasChildren ? (
                          isExpanded ? (
                            <ChevronDown className="w-3.5 h-3.5 text-[#9CA3AF]" />
                          ) : (
                            <ChevronRight className="w-3.5 h-3.5 text-[#9CA3AF]" />
                          )
                        ) : item.hasArrow ? (
                          <ChevronRight className="w-3.5 h-3.5 text-[#9CA3AF]" />
                        ) : null}
                      </button>

                      {/* Danh sách mục con (Accordion) */}
                      {hasChildren && isExpanded && (
                        <div className="mt-0.5 ml-2.5 pl-2.5 border-l border-[#2E3138] space-y-0.5">
                          {item.children.map((child) => {
                            const isChildActive = activeArticleId === child.id;
                            return (
                              <button
                                key={child.id}
                                onClick={() => {
                                  setActiveArticleId(child.id);
                                  setMobileMenuOpen(false);
                                }}
                                className={`w-full flex items-center justify-between px-2.5 py-1.5 rounded-md text-left transition-colors ${
                                  isChildActive
                                    ? 'bg-[#272930] text-[#F7F7F8] font-medium'
                                    : 'text-[#D5D7DD] hover:bg-[#1F2229] hover:text-[#F7F7F8]'
                                }`}
                              >
                                <span className="truncate">
                                  {lang === 'en' ? child.title : child.titleVi}
                                </span>
                                {child.id === 'games-and-places' && (
                                  <ChevronRight className="w-3.5 h-3.5 text-[#9CA3AF]" />
                                )}
                              </button>
                            );
                          })}
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      </aside>

      {/* =====================================================================
          CỘT 3: KHU VỰC NỘI DUNG CHÍNH (MAIN CONTENT)
         ===================================================================== */}
      <div className="flex-1 flex flex-col min-w-0 bg-[#111215]">
        {/* Thanh Topbar chứa Breadcrumb + Search Ctrl+K + Xem cấu trúc GitHub */}
        <header className="h-14 px-4 sm:px-8 border-b border-[#2E3138] flex items-center justify-between shrink-0 bg-[#111215]/95 backdrop-blur-xs">
          <div className="flex items-center gap-2 text-sm text-[#9CA3AF] truncate">
            <button
              onClick={() => setMobileMenuOpen(true)}
              className="lg:hidden p-1.5 mr-1 rounded-md hover:bg-[#272930] text-[#F7F7F8]"
              aria-label="Open navigation"
            >
              <Menu className="w-5 h-5" />
            </button>

            {/* Breadcrumbs */}
            <nav className="flex items-center gap-1.5 truncate">
              {activeArticle.breadcrumbs.map((crumb, index) => {
                const isLast = index === activeArticle.breadcrumbs.length - 1;
                return (
                  <React.Fragment key={index}>
                    {index === 0 && <Layers className="w-4 h-4 text-[#9CA3AF] mr-1 hidden sm:inline" />}
                    <span
                      className={`truncate ${
                        isLast ? 'text-[#F7F7F8] font-medium' : 'hover:text-[#F7F7F8] cursor-pointer'
                      }`}
                      onClick={() => {
                        if (index === 0) setActiveArticleId('projects-overview');
                      }}
                    >
                      {crumb}
                    </span>
                    {!isLast && <span className="text-[#4B5563]">/</span>}
                  </React.Fragment>
                );
              })}
            </nav>
          </div>

          {/* Nút tìm kiếm nhanh (Ctrl+K) & Nút xem cấu trúc GitHub */}
          <div className="flex items-center gap-2.5 shrink-0">
            <button
              onClick={() => setGithubModalOpen(true)}
              className="hidden sm:flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-[#191B1F] hover:bg-[#272930] border border-[#2E3138] text-xs text-[#D5D7DD] transition-colors"
              title="Inspect GitHub navigation.json"
            >
              <FileCode2 className="w-3.5 h-3.5 text-[#335FFF]" />
              <span>navigation.json</span>
            </button>

            <button
              onClick={() => setSearchOpen(true)}
              className="flex items-center gap-3 px-3 py-1.5 rounded-lg bg-[#191B1F] hover:bg-[#272930] border border-[#2E3138] text-sm text-[#9CA3AF] transition-colors"
            >
              <Search className="w-4 h-4 text-[#D5D7DD]" />
              <span className="hidden sm:inline text-xs">Search</span>
              <kbd className="hidden md:inline-block px-1.5 py-0.5 text-[10px] font-mono rounded bg-[#272930] text-[#D5D7DD] border border-[#383C45]">
                Ctrl K
              </kbd>
            </button>
          </div>
        </header>

        {/* Vùng cuộn chứa bài viết + Mục lục bên phải */}
        <div ref={mainScrollRef} className="flex-1 overflow-y-auto">
          <div className="max-w-6xl mx-auto px-5 sm:px-10 py-8 flex gap-10">
            {/* Nội dung bài viết chính */}
            <article className="flex-1 min-w-0 max-w-3xl pb-20">
              {/* Tiêu đề H1 + Thanh công cụ bài viết (English/VI, Feedback, Edit) */}
              <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 mb-6 border-b border-[#2E3138]/80">
                <h1 className="text-3xl sm:text-4xl font-bold text-[#F7F7F8] tracking-tight">
                  {lang === 'en' ? activeArticle.titleEn : activeArticle.titleVi}
                </h1>

                <div className="flex items-center gap-2 shrink-0 flex-wrap">
                  {/* Nút chuyển đổi ngôn ngữ EN / VI */}
                  <button
                    onClick={() => setLang(lang === 'en' ? 'vi' : 'en')}
                    className="flex items-center gap-1.5 px-2.5 py-1.5 rounded-md text-xs font-medium text-[#D5D7DD] hover:text-[#F7F7F8] hover:bg-[#272930] transition-colors"
                    title="Switch language"
                  >
                    <Globe className="w-3.5 h-3.5 text-[#9CA3AF]" />
                    <span>{lang === 'en' ? 'English' : 'Tiếng Việt'}</span>
                  </button>

                  {/* Nút Feedback */}
                  <div className="flex items-center bg-[#191B1F] rounded-md border border-[#2E3138] px-1">
                    <button
                      onClick={() => setFeedbackGiven('up')}
                      className={`p-1.5 rounded hover:bg-[#272930] transition-colors ${
                        feedbackGiven === 'up' ? 'text-emerald-400' : 'text-[#9CA3AF]'
                      }`}
                      title="Helpful"
                    >
                      <ThumbsUp className="w-3.5 h-3.5" />
                    </button>
                    <span className="text-xs text-[#D5D7DD] px-1">
                      {feedbackGiven ? 'Thanks!' : 'Feedback'}
                    </span>
                    <button
                      onClick={() => setFeedbackGiven('down')}
                      className={`p-1.5 rounded hover:bg-[#272930] transition-colors ${
                        feedbackGiven === 'down' ? 'text-rose-400' : 'text-[#9CA3AF]'
                      }`}
                      title="Needs improvement"
                    >
                      <ThumbsDown className="w-3.5 h-3.5" />
                    </button>
                  </div>

                  {/* Nút Edit mở cấu trúc GitHub */}
                  <button
                    onClick={() => setGithubModalOpen(true)}
                    className="flex items-center gap-1.5 px-2.5 py-1.5 rounded-md text-xs font-medium text-[#D5D7DD] hover:text-[#F7F7F8] hover:bg-[#272930] transition-colors"
                    title={`Edit ${activeArticle.githubPath} on GitHub`}
                  >
                    <Edit3 className="w-3.5 h-3.5 text-[#9CA3AF]" />
                    <span>Edit</span>
                  </button>
                </div>
              </div>

              {/* Render nội dung MDX của bài viết */}
              {activeArticle.renderContent(lang, setActiveArticleId)}

              {/* Footer điều hướng bài tiếp theo */}
              <div className="mt-14 pt-6 border-t border-[#2E3138] flex items-center justify-between text-sm">
                <div className="text-[#9CA3AF] text-xs">
                  Roblox Learning Docs • Open Source Markdown Documentation
                </div>
                <button
                  onClick={() =>
                    setActiveArticleId(
                      activeArticleId === 'projects-overview' ? 'games-and-places' : 'projects-overview'
                    )
                  }
                  className="flex items-center gap-2 px-4 py-2 rounded-lg bg-[#191B1F] hover:bg-[#272930] border border-[#2E3138] text-[#F7F7F8] font-medium transition-colors"
                >
                  <span>
                    {activeArticleId === 'projects-overview'
                      ? lang === 'en'
                        ? 'Next: Games and places'
                        : 'Tiếp theo: Games and places'
                      : lang === 'en'
                      ? 'Back to Projects Overview'
                      : 'Quay lại Tổng quan Dự án'}
                  </span>
                  <ChevronRight className="w-4 h-4 text-[#335FFF]" />
                </button>
              </div>
            </article>

            {/* =====================================================================
                CỘT 4: RIGHT TABLE OF CONTENTS ("On this page" - Scroll-Spy)
               ===================================================================== */}
            <aside className="hidden xl:block w-[210px] shrink-0">
              <div className="sticky top-6">
                <div className="text-xs font-semibold text-[#9CA3AF] mb-3 tracking-wide">
                  On this page
                </div>
                <ul className="space-y-1 border-l border-[#2E3138]">
                  {(activeArticle.headings || []).map((heading) => {
                    const isActive = activeHeadingId === heading.id;
                    return (
                      <li key={heading.id}>
                        <button
                          onClick={() => scrollToHeading(heading.id)}
                          className={`w-full text-left pl-3.5 py-1.5 text-[13px] transition-all border-l-2 -ml-[1px] rounded-r-md ${
                            isActive
                              ? 'border-[#335FFF] bg-[#272930]/80 text-[#F7F7F8] font-medium'
                              : 'border-transparent text-[#9CA3AF] hover:text-[#F7F7F8]'
                          }`}
                        >
                          {lang === 'en' ? heading.textEn : heading.textVi}
                        </button>
                      </li>
                    );
                  })}
                </ul>
              </div>
            </aside>
          </div>
        </div>
      </div>

      {/* Modals */}
      <SearchModal
        isOpen={searchOpen}
        onClose={() => setSearchOpen(false)}
        onSelectArticle={setActiveArticleId}
        lang={lang}
      />

      <GitHubStructureModal
        isOpen={githubModalOpen}
        onClose={() => setGithubModalOpen(false)}
        activeArticle={activeArticle}
      />
    </div>
  );
}
