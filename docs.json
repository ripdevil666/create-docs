{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Roblox",
  "colors": {
    "primary": "#335FFF",
    "light": "#4C75FF",
    "dark": "#335FFF"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "background": {
    "color": {
      "dark": "#111215",
      "light": "#111215"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Learn",
        "languages": [
          {
            "language": "en",
            "default": true,
            "groups": [
              {
                "group": "Home",
                "pages": [
                  "index"
                ]
              },
              {
                "group": "Docs",
                "pages": [
                  "docs/experiences",
                  "docs/avatar",
                  "docs/assets",
                  "docs/programs-and-policies"
                ]
              },
              {
                "group": "APIs and Tools",
                "pages": [
                  "apis-and-tools/engine",
                  "apis-and-tools/studio",
                  "apis-and-tools/open-cloud",
                  "apis-and-tools/analytics"
                ]
              },
              {
                "group": "Resources",
                "pages": [
                  "resources/get-started",
                  "resources/tutorials",
                  "resources/code-and-assets"
                ]
              },
              {
                "group": "More",
                "pages": [
                  "more/overview"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "Thử Lại"
    }
  }
}
