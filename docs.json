const SearchModal = ({ isOpen, onClose, onSelectArticle, lang }) => {
  const [query, setQuery] = useState('');
  const inputRef = useRef(null);

  useEffect(() => {
    if (isOpen) {
      setQuery('');
      setTimeout(() => inputRef.current?.focus(), 50);
    }
  }, [isOpen]);

  const allSearchableItems = useMemo(() => {
    const list = [];
    NAVIGATION_CONFIG.sidebar.topItems.forEach((item) =>
      list.push({ id: item.id, title: item.title, titleVi: item.titleVi, category: 'Overview' })
    );
    NAVIGATION_CONFIG.sidebar.sections.forEach((sec) => {
      sec.items.forEach((item) => {
        if (item.path) {
          list.push({ id: item.id, title: item.title, titleVi: item.titleVi, category: sec.category });
        }
        if (item.children) {
          item.children.forEach((child) => {
            list.push({
              id: child.id,
              title: `${item.title} › ${child.title}`,
              titleVi: `${item.titleVi} › ${child.titleVi}`,
              category: sec.category,
            });
          });
        }
      });
    });
    return list;
  }, []);

  const filtered = allSearchableItems.filter((item) => {
    const q = query.toLowerCase();
    return item.title.toLowerCase().includes(q) || item.titleVi.toLowerCase().includes(q);
  });

  if (!isOpen) return null;

  return (
    <div className="fixed inset-0 z-50 flex items-start justify-center pt-20 px-4 bg-black/70 backdrop-blur-xs">
      <div className="w-full max-w-xl rounded-xl bg-[#191B1F] border border-[#2E3138] shadow-2xl overflow-hidden">
        <div className="flex items-center px-4 py-3 border-b border-[#2E3138]">
          <Search className="w-5 h-5 text-[#9CA3AF] mr-3" />
          <input
            ref={inputRef}
            type="text"
            value={query}
            onChange={(e) => setQuery(e.target.value)}
            placeholder={lang === 'en' ? 'Search documentation...' : 'Tìm kiếm tài liệu Roblox...'}
            className="w-full bg-transparent text-[#F7F7F8] placeholder-[#9CA3AF] focus:outline-none text-sm"
          />
          <button onClick={onClose} className="p-1 text-[#9CA3AF] hover:text-[#F7F7F8]">
            <X className="w-4 h-4" />
          </button>
        </div>
        <div className="max-h-80 overflow-y-auto p-2">
          {filtered.length === 0 ? (
            <div className="py-8 text-center text-sm text-[#9CA3AF]">
              {lang === 'en' ? 'No matching articles found.' : 'Không tìm thấy tài liệu phù hợp.'}
            </div>
          ) : (
            filtered.map((item) => (
              <button
                key={item.id}
                onClick={() => {
                  onSelectArticle(item.id);
                  onClose();
                }}
                className="w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-left hover:bg-[#272930] transition-colors group"
              >
                <div className="flex items-center gap-3">
                  <BookOpen className="w-4 h-4 text-[#335FFF]" />
                  <span className="text-sm font-medium text-[#F7F7F8] group-hover:text-white">
                    {lang === 'en' ? item.title : item.titleVi}
                  </span>
                </div>
                <span className="text-xs px-2 py-0.5 rounded bg-[#272930] text-[#9CA3AF]">
                  {item.category}
                </span>
              </button>
            ))
          )}
        </div>
        <div className="px-4 py-2 bg-[#14161A] border-t border-[#2E3138] flex justify-between text-[11px] text-[#9CA3AF]">
          <span>Roblox Learning Docs Search</span>
          <span>ESC to close</span>
        </div>
      </div>
    </div>
  );
};

